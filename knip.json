{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/features/story/use-story-available.ts",
    "src/**/*.test.{ts,tsx}",
    "scripts/**/*.ts",
    "src/bindings.ts"
  ],
  "project": ["src/**/*.{ts,tsx,css,mdx}", "scripts/**/*.ts"],
  "ignore": ["src/components/ui/**"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "off",
    "duplicates": "off",
    "enumMembers": "off",
    "dependencies": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "unlisted": "off",
    "unresolved": "off",
    "binaries": "off"
  }
}
