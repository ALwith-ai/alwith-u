{
  "name": "alwith-u",
  "private": true,
  "version": "0.2.14",
  "description": "An independent desktop client for the OpenAI Codex CLI",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "storybook": "bun --bun ./node_modules/storybook/dist/bin/dispatcher.js dev -p 6007 --host 127.0.0.1 --no-open --disable-telemetry",
    "storybook:build": "bun --bun ./node_modules/storybook/dist/bin/dispatcher.js build --disable-telemetry",
    "storybook:check": "tsc -p .storybook/tsconfig.json --noEmit",
    "storybook:test": "vitest run --config .storybook/vitest.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:tauri": "tauri dev --features hasgard-testing --config src-tauri/tauri.dev-instance.conf.json",
    "bindings": "bun scripts/bindings.ts",
    "typecheck": "tsc -b",
    "test": "bun run test:scripts && vitest run",
    "test:live": "bun run stage && bun scripts/live.ts",
    "lint": "bun lint",
    "ts7-lint": "ts7-lint",
    "format": "bun fmt",
    "stage": "bun scripts/stage.ts",
    "lint:fix": "bun lint --fix",
    "knip": "knip --no-progress",
    "bindings:check": "bun scripts/bindings.ts --check",
    "check:toolchain": "bun scripts/check-toolchain.ts",
    "test:scripts": "bun test scripts/lib",
    "test:watch": "vitest"
  },
