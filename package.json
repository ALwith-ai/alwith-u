{
  "name": "alwith-u",
  "private": true,
  "version": "0.1.0",
  "description": "An independent desktop client for the OpenAI Codex CLI",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:tauri": "tauri dev --features hasgard-testing --config src-tauri/tauri.dev-instance.conf.json",
    "typecheck": "tsc -b",
    "test": "bun test src scripts/lib",
    "test:live": "bun run stage && bun scripts/live.ts",
    "lint": "oxlint",
    "format": "prettier --write \"{src,scripts}/**/*.{ts,tsx,css}\"",
    "stage": "bun scripts/stage.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@alwith/api": "0.1.1",
    "@alwith/module-auth": "0.1.0",
    "@alwith/module-chat": "0.1.0",
    "@alwith/runtime": "0.1.3",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-http": "^2.6.0",
    "@tauri-apps/plugin-log": "^2.9.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "ansi_up": "^6.0.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "diff2html": "^3.4.56",
    "entities": "^8.1.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.2",
    "katex": "^0.18.7",
    "ldrs": "^1.1.9",
    "lucide-react": "^1.44.0",
    "marked": "^18.0.12",
    "marked-linkify-it": "^4.0.2",
    "motion": "^13.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "semver": "^7.8.5",
    "shadcn": "^4.21.0",
    "smplr": "^1.0.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@alwith/native": "0.1.1",
    "@happy-dom/global-registrator": "^20.14.3",
    "@nyssance/codex-acp-v2": "0.6.0",
    "@openai/codex": "0.154.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "optionalDependencies": {
    "@openai/codex-darwin-arm64": "npm:@openai/codex@0.154.0-darwin-arm64",
    "@openai/codex-darwin-x64": "npm:@openai/codex@0.154.0-darwin-x64",
    "@openai/codex-linux-x64": "npm:@openai/codex@0.154.0-linux-x64",
    "@openai/codex-linux-arm64": "npm:@openai/codex@0.154.0-linux-arm64",
    "@openai/codex-win32-x64": "npm:@openai/codex@0.154.0-win32-x64",
    "@openai/codex-win32-arm64": "npm:@openai/codex@0.154.0-win32-arm64"
  }
}
