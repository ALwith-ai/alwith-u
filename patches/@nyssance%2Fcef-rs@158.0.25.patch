diff --git a/rust/sys/runtime_output.rs b/rust/sys/runtime_output.rs
new file mode 100644
index 0000000000000000000000000000000000000000..45a45b3a42ab27360909eb3668726b9787ea4648
--- /dev/null
+++ b/rust/sys/runtime_output.rs
@@ -0,0 +1,46 @@
+use std::{
+    io,
+    path::{Path, PathBuf},
+};
+
+/// Cargo 1.100 separates the package name and fingerprint in build output
+/// paths. Locate the profile's build directory instead of counting parents.
+pub fn profile_dir(out_dir: &Path) -> io::Result<PathBuf> {
+    out_dir
+        .ancestors()
+        .find(|path| path.file_name().is_some_and(|name| name == "build"))
+        .and_then(Path::parent)
+        .map(Path::to_path_buf)
+        .ok_or_else(|| {
+            io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "Cannot locate Cargo profile directory from OUT_DIR",
+            )
+        })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn runtime_files_sit_beside_the_executable_in_both_cargo_layouts() {
+        for out in [
+            "target/debug/build/cef-dll-sys-123/out",
+            "target/debug/build/cef-dll-sys/123/out",
+        ] {
+            assert_eq!(
+                profile_dir(Path::new(out)).unwrap(),
+                PathBuf::from("target/debug")
+            );
+        }
+        assert_eq!(
+            profile_dir(Path::new(
+                "target/x86_64-pc-windows-msvc/release/build/cef-dll-sys/123/out"
+            ))
+            .unwrap(),
+            PathBuf::from("target/x86_64-pc-windows-msvc/release")
+        );
+        assert!(profile_dir(Path::new("unexpected/out")).is_err());
+    }
+}
