--- /dev/null
+++ b/rust/src/__tests__/connection.rs
@@ -0,0 +1,30 @@
+use super::*;
+
+fn descriptor(embedded: bool) -> Value {
+    let mut args = vec!["mcp", "--socket", "private-endpoint", "--host-bundle-id", "test.host"];
+    if embedded {
+        args.insert(1, "--embedded");
+    }
+    json!({
+        "generation":"host-generation", "command":"bundled-driver", "args":args,
+        "env":[
+            {"name":"CMUX_CUA_MCP_FORCE_PROXY","value":"1"},
+            {"name":"CMUX_CUA_SOCKET_AUTH_TOKEN","value":"driver-credential"},
+            {"name":"CMUX_CUA_SOCKET_HOST_AUTH_TOKEN","value":"host-credential"}
+        ]
+    })
+}
+
+#[test]
+fn legacy_native_descriptor_connects_to_the_existing_host_with_the_same_credentials() {
+    let legacy: Connection = serde_json::from_value(descriptor(true)).unwrap();
+    let corrected = legacy.host_proxy();
+    assert_eq!(serde_json::to_value(corrected).unwrap(), descriptor(false));
+}
+
+#[test]
+fn corrected_native_descriptor_is_unchanged() {
+    let current = descriptor(false);
+    let connection: Connection = serde_json::from_value(current.clone()).unwrap();
+    assert_eq!(serde_json::to_value(connection.host_proxy()).unwrap(), current);
+}
