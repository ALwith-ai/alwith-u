@@ -32,6 +32,19 @@ pub struct Connection {
     pub env: Vec<Environment>,
 }
 
+impl Connection {
+    fn host_proxy(mut self) -> Self {
+        // ABI v1 native bundles may still return --embedded for MCP children.
+        // It overrides FORCE_PROXY on Windows/Linux and starts an independent driver.
+        if self.args.first().is_some_and(|arg| arg == "mcp")
+            && self.env.iter().any(|entry| entry.name == "CMUX_CUA_MCP_FORCE_PROXY" && entry.value == "1")
+        {
+            self.args.retain(|arg| arg != "--embedded");
+        }
+        self
+    }
+}
