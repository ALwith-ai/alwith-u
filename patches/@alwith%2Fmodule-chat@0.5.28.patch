+
+#[tokio::test]
+async fn local_http_parse_failures_are_observable_and_listener_survives() {
+    struct Logger(Mutex<Vec<serde_json::Value>>);
+    impl log::Log for Logger {
+        fn enabled(&self, _: &log::Metadata<'_>) -> bool {
+            true
+        }
+        fn log(&self, record: &log::Record<'_>) {
+            let message = record.args().to_string();
+            if let Some(payload) = message.strip_prefix("[alwith-native-network] ") {
+                self.0.lock().unwrap().push(serde_json::from_str(payload).unwrap());
+            }
+        }
+        fn flush(&self) {}
+    }
+    static LOGGER: Logger = Logger(Mutex::new(Vec::new()));
+    log::set_logger(&LOGGER).unwrap();
+    log::set_max_level(log::LevelFilter::Info);
+    let network =
+        NativeNetwork::with_resolver(Arc::new(|_, _| Err("NATIVE_PROXY_RESOLUTION_FAILED")), vec![]).await.unwrap();
+    let endpoint: serde_json::Value = serde_json::from_str(network.endpoint()).unwrap();
+    let port = endpoint["port"].as_u64().unwrap() as u16;
+    let mut socket = TcpStream::connect((std::net::Ipv4Addr::LOCALHOST, port)).await.unwrap();
+    socket.write_all(b"GET /private-request HTTP/1.1\r\nHost: local\r\nprivate invalid header\r\n\r\n").await.unwrap();
+    let mut response = Vec::new();
+    tokio::time::timeout(Duration::from_secs(2), socket.read_to_end(&mut response)).await.unwrap().unwrap();
+    assert!(String::from_utf8_lossy(&response).starts_with("HTTP/1.1 400"));
+    assert_eq!(
+        http(&network, "https://example.test/responses").await.headers()["x-alwith-native-error"],
+        "NATIVE_PROXY_RESOLUTION_FAILED"
+    );
+    let records = LOGGER.0.lock().unwrap();
+    let record = records
+        .iter()
+        .find(|record| {
+            record["targetPort"] == port && record["phase"] == "failed" && record["errorKind"] == "http_protocol"
+        })
+        .expect("local parse failure must be recorded");
+    assert_eq!(record["targetHost"], "127.0.0.1");
+    assert_eq!(record["stage"], "read_request");
+    assert_eq!(record["errorCode"], "NATIVE_NETWORK_PROTOCOL_ERROR");
+    assert!(!record.to_string().contains("private"));
