diff --git a/dist/assistant-image-references.js b/dist/assistant-image-references.js
new file mode 100644
index 0000000000000000000000000000000000000000..2b094b0c4dbfd960e308830695838df667b0fa88
--- /dev/null
+++ b/dist/assistant-image-references.js
@@ -0,0 +1,39 @@
+import { isContentEntry, isImage, isText } from "@nyssance/codex-acp-v2/client";
+import { createChatMarkdown } from "./lib/markdown-rules.js";
+
+const markdown = createChatMarkdown();
+
+/** Generated tool artifacts already have their own reply card; their IDs are not URLs. */
+export function withoutGeneratedImageReferences(content, items) {
+  const references = new Set();
+  for (const item of items) {
+    if (item.kind !== "tool" || item.status !== "completed") continue;
+    const parts = item.content.filter(isContentEntry);
+    if (!parts.some((part) => isImage(part.content))) continue;
+    parts.forEach((part, index) => {
+      if (isImage(part.content)) references.add(`${item.id}:${index}`);
+      if (!isText(part.content)) return;
+      let metadata;
+      try { metadata = JSON.parse(part.content.text); }
+      catch (error) { if (error instanceof SyntaxError) return; throw error; }
+      if (metadata?.kind !== "alwith.image" || !Array.isArray(metadata.images)) return;
+      for (const image of metadata.images) {
+        if (typeof image?.reference === "string") references.add(image.reference);
+      }
+    });
+  }
+  if (references.size === 0) return content;
+  return content.map((block) => {
+    if (!isText(block) || !block.text.includes("![")) return block;
+    const text = markdown.lexer(block.text).map((token) => {
+      if (token.type !== "paragraph" || !token.tokens) return token.raw;
+      let offset = 0;
+      const body = token.tokens.map((part) => {
+        offset += part.raw.length;
+        return part.type === "image" && references.has(part.href) ? "" : part.raw;
+      }).join("");
+      return body + token.raw.slice(offset);
+    }).join("");
+    return text === block.text ? block : { ...block, text };
+  }).filter((block) => !isText(block) || block.text.trim().length > 0);
+}
