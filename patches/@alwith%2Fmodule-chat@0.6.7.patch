@@ -0,0 +1,67 @@
+import { useLayoutEffect, useRef, useState } from "react";
+import { jsx } from "react/jsx-runtime";
+import { t as useTimelineHost } from "./chunk-73099pzj.js";
+
+const progressStops = [[0, 3], [0.1, 25], [0.55, 58], [0.85, 88], [1, 90]];
+
+/** An elapsed-time estimate; generation endpoints do not report measurable progress. */
+export function estimatedImagePercent(startedAt, now) {
+  const elapsed = Math.max(0, (now - startedAt) / 45000);
+  for (let index = 1; index < progressStops.length; index += 1) {
+    const [previousTime, previousPercent] = progressStops[index - 1];
+    const [nextTime, nextPercent] = progressStops[index];
+    if (elapsed <= nextTime) {
+      const fraction = (elapsed - previousTime) / (nextTime - previousTime);
+      return Math.floor(previousPercent + fraction * (nextPercent - previousPercent));
+    }
+  }
+  return Math.min(99, Math.floor(90 + 10 * (1 - Math.exp(-1.5 * (elapsed - 1)))));
+}
+
+export function ImageGenerationProgress({ startedAt }) {
+  const { t } = useTimelineHost();
+  const element = useRef(null);
+  const [percent, setPercent] = useState(3);
+  useLayoutEffect(() => {
+    const document = element.current.ownerDocument;
+    let visible = false;
+    let timer;
+    const stop = () => {
+      clearInterval(timer);
+      timer = undefined;
+    };
+    const update = () => {
+      const next = estimatedImagePercent(startedAt, Date.now());
+      setPercent(next);
+      if (next === 99) stop();
+      return next;
+    };
+    const refresh = () => {
+      stop();
+      if (visible && !document.hidden && update() < 99) {
+        timer = setInterval(update, 500);
+      }
+    };
+    update();
+    const observer = new IntersectionObserver(([entry]) => {
+      visible = entry.isIntersecting;
+      refresh();
+    });
+    observer.observe(element.current);
+    document.addEventListener("visibilitychange", refresh);
+    return () => {
+      observer.disconnect();
+      document.removeEventListener("visibilitychange", refresh);
+      stop();
+    };
+  }, [startedAt]);
+  const label = t("timeline.imageProgressPercent", { percent });
+  return jsx("span", {
+    ref: element,
+    role: "status",
+    title: label,
+    "aria-label": label,
+    className: "text-xs tabular-nums",
+    children: label
+  });
+}
