+// src/alwith/codex/nativeFetch.ts
+import { randomBytes } from "crypto";
+
+// src/alwith/codex/nativeNetworkTransport.ts
+class NativeNetworkTransport {
+  endpoint;
+  constructor(endpoint) {
+    this.endpoint = endpoint;
+  }
+  static fromEnvironment() {
+    const raw = process.env["CODEX_ACP_NATIVE_NETWORK_ENDPOINT"];
+    if (raw === undefined)
+      return null;
+    const value = JSON.parse(raw);
+    if (!value || typeof value !== "object")
+      throw new Error("Invalid native network endpoint");
+    const v = value;
+    if (v["version"] !== 1 || v["host"] !== "127.0.0.1" || !Number.isInteger(v["port"]) || Number(v["port"]) < 1 || Number(v["port"]) > 65535 || typeof v["token"] !== "string" || !/^[a-f0-9]{64}$/.test(v["token"]))
+      throw new Error("Invalid native network endpoint");
+    return new NativeNetworkTransport(value);
+  }
+  route(target, websocket = false, requestId) {
+    return {
+      url: new URL(`http://127.0.0.1:${this.endpoint.port}/v1/${websocket ? "websocket" : "http"}`),
+      headers: {
+        "x-alwith-native-token": this.endpoint.token,
+        "x-alwith-native-target": target.href,
+        ...requestId ? { "x-alwith-native-request-id": requestId } : {}
+      }
+    };
+  }
+}
+function nativeNetworkError(value) {
+  const codes = [
+    "NATIVE_NETWORK_CONNECT_FAILED",
+    "NATIVE_PROXY_RESOLUTION_FAILED",
+    "NATIVE_NETWORK_AUTH_FAILED",
+    "NATIVE_NETWORK_PROTOCOL_ERROR",
+    "NATIVE_NETWORK_CANCELLED",
+    "ETIMEDOUT"
+  ];
+  return typeof value === "string" && codes.includes(value) ? Object.assign(new Error("Native network request failed"), {
+    code: value
+  }) : null;
+}
+
+// src/alwith/codex/nativeFetch.ts
+async function nativeFetch(input, init = {}) {
+  const native = NativeNetworkTransport.fromEnvironment();
+  if (!native)
+    return fetch(input, init);
+  let target = new URL(input);
+  let method = init.method ?? "GET";
+  let body = init.body;
+  const headers = new Headers(init.headers);
+  const requestId = randomBytes(12).toString("hex");
+  for (let redirects = 0;; redirects++) {
+    if (!["http:", "https:"].includes(target.protocol) || target.username || target.password)
+      throw new Error("Invalid native HTTP target");
+    const route = native.route(target, false, requestId);
+    const requestHeaders = new Headers(headers);
+    for (const [name, value] of Object.entries(route.headers))
+      requestHeaders.set(name, value);
+    const response = await fetch(route.url, {
+      ...init,
+      method,
+      body,
+      headers: requestHeaders,
+      redirect: "manual",
+      proxy: false
+    });
+    const error = nativeNetworkError(response.headers.get("x-alwith-native-error"));
+    if (error) {
+      await response.body?.cancel();
+      throw error;
+    }
+    if (![301, 302, 303, 307, 308].includes(response.status) || init.redirect === "manual")
+      return response;
+    const location = response.headers.get("location");
+    if (!location)
+      return response;
+    await response.body?.cancel();
+    if (init.redirect === "error" || redirects === 20)
+      throw new Error("Native HTTP redirect rejected");
+    const next = new URL(location, target);
+    if (next.origin !== target.origin) {
+      for (const header of [
+        "authorization",
+        "cookie",
+        "proxy-authorization",
+        "host"
+      ])
+        headers.delete(header);
+    }
+    if (response.status === 303 && method !== "HEAD" || [301, 302].includes(response.status) && method === "POST") {
+      method = "GET";
+      body = undefined;
+      headers.delete("content-type");
+      headers.delete("content-length");
+    }
+    target = next;
+  }
+}
