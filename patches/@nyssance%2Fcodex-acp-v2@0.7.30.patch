+async function readForkLineage(codexClient, thread) {
+  const lineage = { nativeSessionId: thread.sessionId, forkedFromId: thread.forkedFromId };
+  if (thread.forkedFromId == null) return lineage;
+  async function* pages(threadId, sortDirection) {
+    let cursor = null;
+    const seen = new Set();
+    do {
+      const page = await codexClient.threadTurnsList({ threadId, cursor, limit: 100, sortDirection, itemsView: "summary" });
+      yield page.data;
+      cursor = page.nextCursor;
+      if (cursor !== null) {
+        if (seen.has(cursor)) throw new Error("Codex fork history repeated a pagination cursor");
+        seen.add(cursor);
+      }
+    } while (cursor !== null);
+  }
+  const parentTurns = new Set();
+  for await (const turns of pages(thread.forkedFromId, "asc")) {
+    for (const turn of turns) parentTurns.add(turn.id);
+  }
+  for await (const turns of pages(thread.id, "desc")) {
+    for (const turn of turns) {
+      if (parentTurns.has(turn.id)) return { ...lineage, forkedAtTurnId: turn.id };
+    }
+  }
+  return { ...lineage, forkedAtTurnId: null };
