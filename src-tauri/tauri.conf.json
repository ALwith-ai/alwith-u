{
  "$schema": "https://schema.tauri.app/config/3.0.0-alpha.3",
  "productName": "ALwith U",
  "mainBinaryName": "alwith-u",
  "version": "../package.json",
  "identifier": "ai.alwith.u",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "bun run stage && bun run dev",
    "beforeBuildCommand": "bun run stage && bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ALwith U",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.codex/**"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["alwith-u"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxRDY0MTkxMkUwNjI2NgpSV1JtWXVBU0dXUWRCVjVkQTNjU094b21wbnJOM2l4ZkZjOUFrY29vUjBHU2RmTkpJRDNRTm03OQo=",
      "endpoints": ["https://api.alwith.ai/service/api/v1/open-source-versions/alwith-u/update/{{target}}-{{arch}}/{{current_version}}"]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "alwith.ai",
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "externalBin": ["binaries/alwith-runtime", "binaries/bun", "binaries/codex", "binaries/codex-code-mode-host", "binaries/alwith-codex-launcher"],
    "resources": {
      "resources/adapter": "adapter",
      "resources/licenses": "licenses",
      "resources/native": "native",
      "resources/deepseek": "deepseek",
      "resources/extensions": "extensions"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "entitlements": "./Entitlements.plist"
    }
  }
}
