{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture",
  "description": "Independent playback of session-owned device captures",
  "windows": ["capture-*"],
  "permissions": [
    "core:default",
    "alwith-device:allow-capture-list",
    "alwith-device:allow-capture-access",
    "alwith-device:allow-capture-player-mount",
    "alwith-device:allow-capture-player-update",
    "alwith-device:allow-capture-player-control",
    "alwith-device:allow-capture-player-status",
    "alwith-device:allow-capture-player-unmount"
  ]
}
