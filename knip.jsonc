{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/bindings.ts",
    "src/**/__tests__/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    ".storybook/fixtures/open.ts",
    "src/features/story/use-story-available.ts"
  ],
  "project": ["src/**/*.{ts,tsx,css,less,mdx}", "scripts/**/*.ts"],
  "ignoreIssues": {
    // registry components are kept whole, as upstream ships them
    "src/components/ui/**": ["files", "exports", "types", "duplicates"]
  },
  "ignoreDependencies": [
    // Bundled into the app by scripts/stage.ts from the pinned package versions
    "@openai/codex",
    "@alwith/module-mobile",
    // Consumed by the native host through Cargo, with product-specific menus.
    "@alwith/module-desktop-shell",
    // only imported by the unused registry component ui/message-scroller
    "@shadcn/react",
    // invoked as `bun ts7-lint` by the fabfile.py check gate
    "@nyssance/ts7-lint"
  ],
  // rustc supplies the host target triple; fmt is built into Bun rather than installed from npm.
  "ignoreBinaries": ["rustc", "fmt"]
}
